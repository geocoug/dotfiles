{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "text": "#E6EDF3",
    "grey": "#9AA4B2",
    "dim": "#6B7280",
    "faint": "#3F4451",
    "green": "#81FF91",
    "amber": "#FFB454",
    "purple": "#C4A7FF",
    "red": "#FF6B6B",
    "yellow": "#E0AF68",
    "cyan": "#7DCFFF",
    "parent": "#7AA2F7"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "template": "{{ if eq .PWD \"~\" }}<p:text><b>~</b></>{{ else }}<p:parent>{{ trimSuffix .Folder .PWD }}</><p:text><b>{{ .Folder }}</b></>{{ end }}\n\u276f "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:text",
          "options": {
            "style": "full",
            "home_icon": "~",
            "folder_separator_icon": "/"
          },
          "template": "{{ if eq .Path \"~\" }}<b>~</b>{{ else }}<p:parent>{{ .Parent }}</><b>{{ .Folder }}</b>{{ end }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:grey",
          "options": {
            "branch_icon": "",
            "branch_max_length": 25,
            "fetch_status": true,
            "fetch_stash_count": true
          },
          "template": "<p:faint> \u2502 </>{{ if and (gt .Ahead 0) (gt .Behind 0) }}<p:red>\u25cf</>{{ else if or (.Working.Changed) (.Staging.Changed) }}<p:amber>\u25cf</>{{ else if or (gt .Ahead 0) (gt .Behind 0) }}<p:purple>\u25cf</>{{ else }}<p:green>\u25cf</>{{ end }} {{ .HEAD }}{{ if gt .Ahead 0 }} <p:purple>\u2191{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }} <p:purple>\u2193{{ .Behind }}</>{{ end }}{{ if .Working.Changed }} <p:amber>{{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <p:green>staged {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <p:dim>*{{ .StashCount }}</>{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "\u2718 {{ .Code }}<p:faint> \u2502 </>"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "options": {
            "display_mode": "environment",
            "fetch_version": true
          },
          "template": "\ue235 {{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }}<p:faint> \u2502 </>"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:cyan",
          "options": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": "{{ .FormattedMs }}<p:faint> \u2502 </>"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "options": {
            "time_format": "3:04 PM"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "\u276f "
        }
      ]
    }
  ]
}
